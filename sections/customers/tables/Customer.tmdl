table Customer

	column CustomerKey
		dataType: int64
		isKey
		isHidden
		summarizeBy: none

	column CustomerCode
		dataType: string
		summarizeBy: none

	column CustomerName
		dataType: string
		summarizeBy: none

	column Segment
		dataType: string
		summarizeBy: none

	column Region
		dataType: string
		summarizeBy: none

	column Country
		dataType: string
		summarizeBy: none

	column AcquisitionDateKey
		dataType: dateTime
		isHidden
		formatString: Short Date
		summarizeBy: none

	column IsActive
		dataType: boolean
		summarizeBy: none

	hierarchy 'Customer Geography'

		level Country
			column: Country

		level Region
			column: Region

		level CustomerName
			column: CustomerName

	partition 'Customer-partition' = m
		mode: import
		source =
			#table(
				type table [
					CustomerKey = Int64.Type,
					CustomerCode = text,
					CustomerName = text,
					Segment = text,
					Region = text,
					Country = text,
					AcquisitionDateKey = datetime,
					IsActive = logical
				],
				{}
			)
