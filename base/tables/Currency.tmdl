table Currency
	isHidden

	column CurrencyKey
		dataType: int64
		isKey
		isHidden
		summarizeBy: none

	column CurrencyCode
		dataType: string
		summarizeBy: none

	column CurrencyName
		dataType: string
		summarizeBy: none

	partition 'Currency-partition' = m
		mode: import
		source =
			#table(
				type table [
					CurrencyKey = Int64.Type,
					CurrencyCode = text,
					CurrencyName = text
				],
				{}
			)
